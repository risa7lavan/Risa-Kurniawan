# =========================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (Vercel & Local Development)
# =========================================================================

# --- 1. SUPABASE DATABASE CONFIGURATION (WAJIB UNTUK LIVE CMS PERSISTENCE) ---
# Dapatkan dari: Supabase Dashboard > Project Settings > API
# SUPABASE_URL: Project URL (Contoh: https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_SECRET_KEY / SERVICE_ROLE_KEY:
# Gunakan "service_role" secret key (BUKAN anon key) agar backend dapat menyimpan
# dan membaca data CMS tanpa batasan Row Level Security.
# AMAN: Key ini hanya diakses di sisi server (serverless API Vercel), TIDAK pernah diekspos ke browser pengunjung.
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# --- 2. GOOGLE GEMINI AI CONFIGURATION (Untuk Fitur AI Generator Artikel & Tutorial) ---
# Dapatkan gratis dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# --- 3. APLIKASI WEB URL ---
APP_URL="https://your-domain.vercel.app"
